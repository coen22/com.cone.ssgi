// Edge-adaptive 5x5 single-frame denoiser driven by a 2D weight LUT.

#pragma kernel Spatial5x5
#pragma target 5.0
#pragma multi_compile _ _GBUFFER_NORMALS_OCT

#ifndef UNITY_COMPILER_HLSL
#define UNITY_COMPILER_HLSL 1
#endif

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Packing.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

Texture2D<float4> _NoisySSGI;
Texture2D<float>  _DepthTexture;
Texture2D<float4> _NormalTexture;
Texture2D<float>  _WeightLUT;

RWTexture2D<float4> _SSGI_Denoised;

CBUFFER_START(SpatialParams)
    // xy = texel size, zw = texture dimensions
    float4 _TexelSize;
    // Radii per edge tier
    float4 _FilterRadii;
    // Edge thresholds (ascending) + unused w
    float4 _EdgeThresholds;
    // x = depth scale, y = normal scale, zw unused
    float4 _EdgeComplexityParams;
    // x = guide normal power, y = guide depth scale, z = enable normal gate (0/1), w = enable depth gate (0/1)
    float4 _GuideParams;
    // x = max distance for LUT V coordinate, y = minimum weight epsilon, zw unused
    float4 _MiscParams;
CBUFFER_END

float4 _SpatialZBufferParams;

static const int kKernelRadius = 2;

uint2 ClampCoord(uint2 coord, uint width, uint height)
{
    uint clampedX = min(coord.x, max(width, 1u) - 1u);
    uint clampedY = min(coord.y, max(height, 1u) - 1u);
    return uint2(clampedX, clampedY);
}

float4 SafeLoadRGBA(Texture2D<float4> tex, int2 p, uint width, uint height)
{
    uint2 clamped = ClampCoord(uint2(max(p.x, 0), max(p.y, 0)), width, height);
    return tex.Load(int3(clamped, 0));
}

float SafeLoadR(Texture2D<float> tex, int2 p, uint width, uint height)
{
    uint2 clamped = ClampCoord(uint2(max(p.x, 0), max(p.y, 0)), width, height);
    return tex.Load(int3(clamped, 0));
}

float3 DecodeNormal(float4 encoded)
{
#if defined(_GBUFFER_NORMALS_OCT)
    float2 remapped = Unpack888ToFloat2(encoded.xyz);
    float2 oct = remapped * 2.0 - 1.0;
    return normalize(UnpackNormalOctQuadEncode(oct));
#else
    return normalize(encoded.xyz * 2.0 - 1.0);
#endif
}

struct DepthSample
{
    float linear01;
    float eye;
};

DepthSample SampleDepth(Texture2D<float> tex, int2 p, uint width, uint height)
{
    float raw = SafeLoadR(tex, p, width, height);
    DepthSample result;
#if UNITY_REVERSED_Z
    if (abs(raw - UNITY_RAW_FAR_CLIP_VALUE) < 1e-6)
    {
        // Far plane in reversed Z should correspond to linear01 = 1.0
        result.linear01 = 1.0;
        result.eye      = LinearEyeDepth(raw, _SpatialZBufferParams);
    }
    else
    {
        result.linear01 = saturate(_SpatialZBufferParams.z * raw + _SpatialZBufferParams.w);
        result.eye      = LinearEyeDepth(raw, _SpatialZBufferParams);
    }
#else
    if (abs(raw - UNITY_RAW_FAR_CLIP_VALUE) < 1e-6)
    {
        result.linear01 = 1.0;
        result.eye      = LinearEyeDepth(raw, _SpatialZBufferParams);
    }
    else
    {
        raw = lerp(UNITY_NEAR_CLIP_VALUE, 1.0, raw);
        result.linear01 = saturate(Linear01Depth(raw, _SpatialZBufferParams));
        result.eye      = LinearEyeDepth(raw, _SpatialZBufferParams);
    }
#endif
    return result;
}

float ComputeEdgeComplexity(
    int2 p,
    uint width,
    uint height,
    float depthScale,
    float normalScale,
    out float3 centerNormal
)
{
    float depthL = SampleDepth(_DepthTexture, p + int2(-1, 0), width, height).linear01;
    float depthR = SampleDepth(_DepthTexture, p + int2(1, 0), width, height).linear01;
    float depthT = SampleDepth(_DepthTexture, p + int2(0, -1), width, height).linear01;
    float depthB = SampleDepth(_DepthTexture, p + int2(0, 1), width, height).linear01;

    float2 depthGrad = float2(depthR - depthL, depthB - depthT);
    float eDepth = length(depthGrad);

    float3 normalL = DecodeNormal(SafeLoadRGBA(_NormalTexture, p + int2(-1, 0), width, height));
    float3 normalR = DecodeNormal(SafeLoadRGBA(_NormalTexture, p + int2(1, 0), width, height));
    float3 normalT = DecodeNormal(SafeLoadRGBA(_NormalTexture, p + int2(0, -1), width, height));
    float3 normalB = DecodeNormal(SafeLoadRGBA(_NormalTexture, p + int2(0, 1), width, height));

    float3 center = DecodeNormal(SafeLoadRGBA(_NormalTexture, p, width, height));
    centerNormal = center;

    float3 normalDiffSum = (normalR - normalL) + (normalB - normalT);
    float eNormal = length(normalDiffSum) * 0.5;

    float edge = depthScale * eDepth + normalScale * eNormal;
    return saturate(edge);
}

float SelectRadius(float edgeComplexity)
{
    float thresholds[3] = { _EdgeThresholds.x, _EdgeThresholds.y, _EdgeThresholds.z };
    float radii[4] = { _FilterRadii.x, _FilterRadii.y, _FilterRadii.z, _FilterRadii.w };

    int tier = 3;
    if (edgeComplexity < thresholds[0]) tier = 0;
    else if (edgeComplexity < thresholds[1]) tier = 1;
    else if (edgeComplexity < thresholds[2]) tier = 2;

    return radii[tier];
}

float SampleWeight(float edgeComplexity, float distance)
{
    float maxDistance = max(_MiscParams.x, 1e-4);
    float dist01 = saturate(distance / maxDistance);
    float2 uv = float2(saturate(edgeComplexity), dist01);
    return _WeightLUT.SampleLevel(sampler_LinearClamp, uv, 0).r;
}

[numthreads(8, 8, 1)]
void Spatial5x5(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint width = (uint)max(_TexelSize.z, 0.0);
    uint height = (uint)max(_TexelSize.w, 0.0);

    if (width == 0u || height == 0u)
        return;

    int2 p = int2(dispatchThreadID.xy);
    if ((uint)p.x >= width || (uint)p.y >= height)
        return;

    float depthScale = _EdgeComplexityParams.x;
    float normalScale = _EdgeComplexityParams.y;
    float guideNormalPower = _GuideParams.x;
    float guideDepthScale = _GuideParams.y;
    bool enableNormalGate = (_GuideParams.z > 0.5);
    bool enableDepthGate = (_GuideParams.w > 0.5);
    float minWeight = max(_MiscParams.y, 0.0);

    float3 centerNormal;
    float edgeComplexity = ComputeEdgeComplexity(p, width, height, depthScale, normalScale, centerNormal);

    DepthSample centerDepth = SampleDepth(_DepthTexture, p, width, height);
    float3 centerColor = SafeLoadRGBA(_NoisySSGI, p, width, height).rgb;

    float radius = SelectRadius(edgeComplexity);

    float3 accum = 0.0.xxx;
    float weightSum = 0.0;

    [unroll]
    for (int dy = -kKernelRadius; dy <= kKernelRadius; ++dy)
    {
        [unroll]
        for (int dx = -kKernelRadius; dx <= kKernelRadius; ++dx)
        {
            float distance = length(float2(dx, dy));
            if (distance > radius)
                continue;

            int2 sampleCoord = p + int2(dx, dy);
            DepthSample sampleDepth = SampleDepth(_DepthTexture, sampleCoord, width, height);

            float weight = SampleWeight(edgeComplexity, distance);
            if (weight < minWeight)
                continue;

            float depthDelta = abs(sampleDepth.linear01 - centerDepth.linear01);
            if (enableDepthGate)
            {
                float atten = rcp(1.0 + guideDepthScale * depthDelta);
                weight *= atten;
            }

            float3 sampleNormal = DecodeNormal(SafeLoadRGBA(_NormalTexture, sampleCoord, width, height));
            if (enableNormalGate)
            {
                float cosSim = max(dot(centerNormal, sampleNormal), 0.0);
                weight *= pow(saturate(cosSim), guideNormalPower);
            }

            if (weight < minWeight)
                continue;

            float3 sampleColor = SafeLoadRGBA(_NoisySSGI, sampleCoord, width, height).rgb;

            accum += sampleColor * weight;
            weightSum += weight;
        }
    }

    float invWeight = (weightSum > minWeight) ? rcp(weightSum) : 0.0;
    float3 filtered = (weightSum > minWeight) ? accum * invWeight : centerColor;
    _SSGI_Denoised[p] = float4(filtered, 1.0);
}