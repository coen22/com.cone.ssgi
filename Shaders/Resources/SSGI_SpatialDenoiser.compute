// SSGI_SpatialDenoiser.compute
// Single-frame cross-bilateral denoiser for noisy SSGI buffers.
// Guide signals: depth (linear), normals, optional albedo.
// Platform notes: avoid vendor intrinsics; stick to HLSL 5.0 features.

#pragma kernel Denoise
#pragma target 5.0
#pragma multi_compile _ _GBUFFER_NORMALS_OCT

#define GROUP_SIZE_X 16
#define GROUP_SIZE_Y 16
#define MAX_RADIUS   6
#define SHARED_DIM_X (GROUP_SIZE_X + MAX_RADIUS * 2)
#define SHARED_DIM_Y (GROUP_SIZE_Y + MAX_RADIUS * 2)

#ifndef UNITY_COMPILER_HLSL
#define UNITY_COMPILER_HLSL 1
#endif

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/CommonLighting.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

// Resources
Texture2D<float4> _NoisySSGI;       // RGB = indirect diffuse (noisy)
Texture2D<float>  _DepthTexture;    // Device depth (converted to linear inside shader)
Texture2D<float4> _NormalTexture;   // Encoded normals (view or world)
Texture2D<float4> _AlbedoTexture;   // Optional (can be black if unused)

RWTexture2D<float4> _OutDenoised;   // Output RGB

// Params
CBUFFER_START(SSGIDenoiseParams)
    float2 _TexSize;          // xy = width, height
    float  _Radius;           // e.g. 3–6 (int radius)
    float  _SigmaColor;       // color similarity (0.1–0.3)
    float  _SigmaNormal;      // normal angle sigma (in cos-space, 0.1–0.5)
    float  _SigmaDepth;       // depth sigma in linear [0..1] (e.g. 0.01–0.1)
    float  _AlbedoWeight;     // 0 disables albedo guiding (0..1)
    float  _LumaWeight;       // weight for luma guidance (0..1)
    float  _MinWeight;        // tiny floor to avoid zero sum (e.g. 1e-4)
    uint   _NormalsAreWorld;  // 1 = world, 0 = view (doesn't change filter, only FYI)
    uint   _Pad0;
    uint   _Pad1;
    uint   _Pad2;
CBUFFER_END

float4 _SpatialZBufferParams;

groupshared half4 g_SharedColorDepth[SHARED_DIM_X * SHARED_DIM_Y];
groupshared half4 g_SharedNormalAlbedoR[SHARED_DIM_X * SHARED_DIM_Y];
groupshared half2 g_SharedAlbedoGB[SHARED_DIM_X * SHARED_DIM_Y];
groupshared half  g_SharedAlpha[SHARED_DIM_X * SHARED_DIM_Y];

float3 SafeLoadRGB(Texture2D<float4> tex, int2 p)
{
    uint w = (uint)_TexSize.x, h = (uint)_TexSize.y;
    p = int2(clamp(p.x, 0, int(w - 1)), clamp(p.y, 0, int(h - 1)));
    return tex.Load(int3(p, 0)).xyz;
}

float4 SafeLoadRGBA(Texture2D<float4> tex, int2 p)
{
    uint w = (uint)_TexSize.x, h = (uint)_TexSize.y;
    p = int2(clamp(p.x, 0, int(w - 1)), clamp(p.y, 0, int(h - 1)));
    return tex.Load(int3(p, 0));
}

float SafeLoadR(Texture2D<float> tex, int2 p)
{
    uint w = (uint)_TexSize.x, h = (uint)_TexSize.y;
    p = int2(clamp(p.x, 0, int(w - 1)), clamp(p.y, 0, int(h - 1)));
    return tex.Load(int3(p, 0));
}

// RGB -> luma for color similarity
float Luma(float3 c) { return dot(c, float3(0.299, 0.587, 0.114)); }

static const float kExpMul = 1.442695f; // mul so that exp2(x * kExpMul) == exp(x)

// Gaussian from absolute difference with sigma
float G(float d, float sigma)
{
    float invSigma = -1.0 / max(1e-6, 2.0 * sigma * sigma);
    return exp2(d * d * invSigma * kExpMul);
}

float3 DecodeNormal(float4 encoded)
{
#if defined(_GBUFFER_NORMALS_OCT)
    float2 remappedOct = Unpack888ToFloat2(encoded.xyz);
    float2 oct = remappedOct * 2.0 - 1.0;
    return normalize(UnpackNormalOctQuadEncode(oct));
#else
    return normalize(encoded.xyz * 2.0 - 1.0);
#endif
}

float SampleLinearDepth(Texture2D<float> tex, int2 p)
{
    float raw = SafeLoadR(tex, p);
    if (abs(raw - UNITY_RAW_FAR_CLIP_VALUE) < 1e-6)
        return 1.0;
#if !UNITY_REVERSED_Z
    raw = lerp(UNITY_NEAR_CLIP_VALUE, 1.0, raw);
#endif
    return saturate(Linear01Depth(raw, _SpatialZBufferParams));
}

float NormalWeight(float3 n0, float3 n1, float sigmaCos)
{
    float c = saturate(dot(normalize(n0), normalize(n1)));
    float diff = 1.0 - c;
    float invSigma = -1.0 / max(1e-6, 2.0 * sigmaCos * sigmaCos);
    return exp2(diff * invSigma * kExpMul);
}

uint ToSharedIndex(uint x, uint y)
{
    return y * SHARED_DIM_X + x;
}

[numthreads(GROUP_SIZE_X, GROUP_SIZE_Y, 1)]
void Denoise(
    uint3 dispatchThreadID : SV_DispatchThreadID,
    uint3 groupThreadID : SV_GroupThreadID,
    uint3 groupID : SV_GroupID
)
{
    uint width = (uint)_TexSize.x;
    uint height = (uint)_TexSize.y;
    if (width == 0 || height == 0)
        return;

    int radiusInt = (int)floor(_Radius + 0.5);
    int rad = min(MAX_RADIUS, max(0, radiusInt));
    float sigmaS = max(1.0, _Radius) * 0.75;

    bool useAlbedo = (_AlbedoWeight > 0.0);
    bool useLuma = (_LumaWeight > 0.0);
    bool useNormal = (_SigmaNormal > 0.0);
    bool useDepth = (_SigmaDepth > 0.0);

    uint2 tileOrigin = groupID.xy * uint2(GROUP_SIZE_X, GROUP_SIZE_Y);
    int2 baseCoord = int2(tileOrigin) - int2(MAX_RADIUS, MAX_RADIUS);

    for (uint sy = groupThreadID.y; sy < SHARED_DIM_Y; sy += GROUP_SIZE_Y)
    {
        for (uint sx = groupThreadID.x; sx < SHARED_DIM_X; sx += GROUP_SIZE_X)
        {
            int2 sampleCoord = baseCoord + int2(sx, sy);
            float4 noisySample = SafeLoadRGBA(_NoisySSGI, sampleCoord);
            float depthSample = SampleLinearDepth(_DepthTexture, sampleCoord);
            float3 normalSample = DecodeNormal(SafeLoadRGBA(_NormalTexture, sampleCoord));
            float3 albedoSample = useAlbedo ? SafeLoadRGB(_AlbedoTexture, sampleCoord) : 0.0.xxx;

            uint sharedIndex = ToSharedIndex(sx, sy);
            g_SharedColorDepth[sharedIndex] = half4(noisySample.rgb, depthSample);
            g_SharedAlpha[sharedIndex] = half(noisySample.a);
            g_SharedNormalAlbedoR[sharedIndex] = half4(normalSample, albedoSample.x);
            g_SharedAlbedoGB[sharedIndex] = half2(albedoSample.yz);
        }
    }

    GroupMemoryBarrierWithGroupSync();

    uint localX = groupThreadID.x + MAX_RADIUS;
    uint localY = groupThreadID.y + MAX_RADIUS;
    int localXi = (int)localX;
    int localYi = (int)localY;
    uint centerIndex = ToSharedIndex(localX, localY);

    float4 packedCenter = float4(g_SharedColorDepth[centerIndex]);
    float3 Cc = packedCenter.xyz;
    float Dc = packedCenter.w;
    float centerAlpha = (float)g_SharedAlpha[centerIndex];

    float4 packedNormalAlbedo = float4(g_SharedNormalAlbedoR[centerIndex]);
    float2 packedAlbedoGB = float2(g_SharedAlbedoGB[centerIndex]);
    float3 Nc = packedNormalAlbedo.xyz;
    float3 Ac = float3(packedNormalAlbedo.w, packedAlbedoGB);

    float3 num = 0.0.xxx;
    float  den = 0.0;

    float lumaC = Luma(Cc);

    int2 outputCoord = int2(dispatchThreadID.xy);
    bool writeOutput = (dispatchThreadID.x < width) && (dispatchThreadID.y < height);

    for (int dy = -rad; dy <= rad; ++dy)
    {
        for (int dx = -rad; dx <= rad; ++dx)
        {
            uint sharedIndex = ToSharedIndex((uint)(localXi + dx), (uint)(localYi + dy));

            float4 packedNeighbor = float4(g_SharedColorDepth[sharedIndex]);
            float3 Cq = packedNeighbor.xyz;
            float  Dq = packedNeighbor.w;
            float4 packedNeighborGuides = float4(g_SharedNormalAlbedoR[sharedIndex]);
            float2 packedNeighborAlbedoGB = float2(g_SharedAlbedoGB[sharedIndex]);
            float3 Nq = packedNeighborGuides.xyz;
            float3 Aq = float3(packedNeighborGuides.w, packedNeighborAlbedoGB);

            float2 dpx = float2(dx, dy);
            float r2 = dot(dpx, dpx);
            float wS = G(sqrt(r2), sigmaS);

            float lumaQ = Luma(Cq);
            float wC = useLuma ? G(abs(lumaQ - lumaC), _SigmaColor) : 1.0;

            float wN = useNormal ? NormalWeight(Nc, Nq, _SigmaNormal) : 1.0;
            float wD = useDepth ? G(abs(Dq - Dc), _SigmaDepth) : 1.0;

            float wA = 1.0;
            if (useAlbedo)
            {
                float aDiff = length(Aq - Ac);
                wA = lerp(1.0, G(aDiff, _SigmaColor), saturate(_AlbedoWeight));
            }

            float wAll = max(_MinWeight, wS * wC * wN * wD * wA);

            num += Cq * wAll;
            den += wAll;
        }
    }

    if (writeOutput)
    {
        float3 outRGB = (den > 0.0) ? (num / den) : Cc;
        _OutDenoised[outputCoord] = float4(outRGB, centerAlpha);
    }
}
